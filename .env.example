# 環境變數範本：複製這個檔案並改名為 .env.local，再填入你自己的真實值
# 注意：.env.local 已被 .gitignore 忽略，絕對不要把真實密碼上傳到 GitHub

# MongoDB Atlas 連線字串（在 Atlas 的 Connect → Drivers 取得）
# 記得把 <username>、<password> 換成資料庫使用者的帳號密碼，並在 .net/ 後面加上資料庫名稱
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/ai-smart-expense?retryWrites=true&w=majority

# 簽署登入憑證（JWT）用的密鑰，請用以下指令產生一組隨機字串：
#   openssl rand -base64 32
JWT_SECRET=<請填入隨機產生的長字串>
